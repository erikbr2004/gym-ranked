{
  "expo": {
    "name": "GymRank",
    "slug": "gym-ranked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E13",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O GymRank usa a câmera para você fotografar seus treinos.",
          "photosPermission": "O GymRank acessa suas fotos para você escolher a imagem de um treino.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O GymRank acessa suas fotos para salvar as imagens dos seus treinos.",
          "savePhotosPermission": "O GymRank salva na galeria as imagens geradas dos seus treinos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ]
    ]
  }
}
